<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f5f5">
    <title>{{ page_title | escape }}{% unless page_title contains shop.name %} · {{ shop.name | escape }}{% endunless %}</title>
    <meta name="description" content="{{ page_description | default: 'Conheça os vendedores disponíveis e os produtos vendidos na nossa loja.' | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {{ content_for_header }}
    <style>
      html { color-scheme: light; }
      body { margin: 0; background: #f5f5f5; color: #000; font-family: Arial, Helvetica, sans-serif; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .skip-link:focus { position: fixed; top: 12px; left: 12px; width: auto; height: auto; padding: 12px; margin: 0; clip: auto; background: #fff; color: #000; z-index: 100; }
    </style>
  </head>
  <body>
    <a href="#MainContent" class="skip-link visually-hidden">{{ 'general.accessibility.skip_to_content' | t }}</a>
    <h1 class="visually-hidden">{{ page_title | escape }}</h1>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
