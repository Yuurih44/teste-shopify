{%- liquid
  assign vendor_type = section.settings.metaobject_type | strip | default: 'store_vendor'
  assign vendor_definition = shop.metaobjects[vendor_type]
  assign heading_tag = 'h2'
  if section.settings.heading_tag == 'h1'
    assign heading_tag = 'h1'
  endif
-%}

{%- capture avatar_icon -%}
  <svg viewBox="0 0 60 60" fill="none" aria-hidden="true" focusable="false"><circle cx="30" cy="30" r="30" fill="#D9D9D9"/><circle cx="30" cy="21" r="8.5" fill="currentColor"/><path d="M13 47v-5c0-7 8-11 17-11s17 4 17 11v5H13Z" fill="currentColor"/></svg>
{%- endcapture -%}
{%- capture shirt_icon -%}
  <svg viewBox="0 0 44 38" fill="currentColor" aria-hidden="true" focusable="false"><path d="m13 2-4 2L1 12a2 2 0 0 0 0 3l5 5a2 2 0 0 0 3 0l3-3v17a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V17l3 3a2 2 0 0 0 3 0l5-5a2 2 0 0 0 0-3l-8-8-4-2a9 9 0 0 1-18 0Z"/></svg>
{%- endcapture -%}

<style>
  #ec-vendors-{{ section.id }} {
    --ec-columns-desktop: {{ section.settings.columns_desktop }};
    --ec-columns-mobile: {{ section.settings.columns_mobile }};
    --ec-card-padding: {{ section.settings.card_padding }}px;
    --ec-border: {{ section.settings.border_color }};
    --ec-card-background: {{ section.settings.card_background }};
    color: #000;
    background: {{ section.settings.section_background }};
    padding: {{ section.settings.section_padding }}px 24px;
    font-family: inherit;
    font-size: 16px;
    line-height: 1.4;
  }
  #ec-vendors-{{ section.id }} * { box-sizing: border-box; }
  #ec-vendors-{{ section.id }} .ec-vendors__inner { width: 100%; max-width: 1578px; margin-inline: auto; }
  #ec-vendors-{{ section.id }} .ec-vendors__header { text-align: center; margin-bottom: 80px; }
  #ec-vendors-{{ section.id }} .ec-vendors__title { color: inherit; font: inherit; font-size: clamp(30px, 3.2vw, 48px); line-height: 1.2; font-weight: 700; margin: 0; overflow-wrap: anywhere; }
  #ec-vendors-{{ section.id }} .ec-vendors__subtitle { font-size: clamp(17px, 1.6vw, 24px); line-height: 1.5; max-width: 72ch; margin: 14px auto 0; overflow-wrap: anywhere; }
  #ec-vendors-{{ section.id }} .ec-vendors__grid { display: grid; grid-template-columns: repeat(var(--ec-columns-desktop), minmax(0, 1fr)); gap: 34px; list-style: none; padding: 0; margin: 0; }
  #ec-vendors-{{ section.id }} .ec-vendors__card { container: ec-vendor / inline-size; min-width: 0; min-height: 270px; padding: var(--ec-card-padding); border: 2px solid var(--ec-border); border-radius: 32px; background: var(--ec-card-background); }
  #ec-vendors-{{ section.id }} .ec-vendors__identity { display: flex; align-items: center; gap: 12px; min-width: 0; }
  #ec-vendors-{{ section.id }} .ec-vendors__avatar { width: 60px; height: 60px; flex: 0 0 60px; overflow: hidden; border-radius: 50%; }
  #ec-vendors-{{ section.id }} .ec-vendors__avatar img,
  #ec-vendors-{{ section.id }} .ec-vendors__avatar svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  #ec-vendors-{{ section.id }} .ec-vendors__name { margin: 0; color: inherit; font: inherit; font-size: 24px; line-height: 1.25; font-weight: 700; overflow-wrap: anywhere; }
  #ec-vendors-{{ section.id }} .ec-vendors__details { min-width: 0; flex: 1; }
  #ec-vendors-{{ section.id }} .ec-vendors__role { margin: 2px 0 0; font-size: 24px; line-height: 1.3; overflow-wrap: anywhere; }
  #ec-vendors-{{ section.id }} .ec-vendors__badge { display: grid; place-items: center; width: 50px; height: 50px; flex: 0 0 50px; margin-left: auto; border: 1px solid currentColor; border-radius: 50%; }
  #ec-vendors-{{ section.id }} .ec-vendors__badge--ouro { color: #997000; background: #f2dfa0; }
  #ec-vendors-{{ section.id }} .ec-vendors__badge--prata { color: #545661; background: #e1e1e7; }
  #ec-vendors-{{ section.id }} .ec-vendors__badge--bronze { color: #923b1b; background: #f1b497; }
  #ec-vendors-{{ section.id }} .ec-vendors__badge svg { width: 28px; height: 28px; }
  #ec-vendors-{{ section.id }} .ec-vendors__products-label { margin: 40px 0 12px; font-size: 14px; color: #555; }
  #ec-vendors-{{ section.id }} .ec-vendors__products { display: flex; flex-wrap: wrap; gap: 12px 18px; list-style: none; margin: 0; padding: 0; }
  #ec-vendors-{{ section.id }} .ec-vendors__product { display: grid; place-items: center; width: 44px; height: 44px; color: inherit; border-radius: 4px; }
  #ec-vendors-{{ section.id }} .ec-vendors__product img { display: block; width: 44px; height: 44px; object-fit: contain; }
  #ec-vendors-{{ section.id }} .ec-vendors__product svg { width: 42px; height: 36px; }
  #ec-vendors-{{ section.id }} .ec-vendors__product:hover { background: #0000000d; }
  #ec-vendors-{{ section.id }} a:focus-visible { outline: 3px solid #005fcc; outline-offset: 4px; }
  #ec-vendors-{{ section.id }} .ec-vendors__empty { text-align: center; padding: 32px; border: 1px dashed #777; border-radius: 12px; }
  #ec-vendors-{{ section.id }} .ec-vendors__pagination { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }
  #ec-vendors-{{ section.id }} .ec-vendors__pagination a,
  #ec-vendors-{{ section.id }} .ec-vendors__pagination [aria-current] { display: inline-block; padding: 10px 14px; color: inherit; border: 1px solid currentColor; border-radius: 6px; }
  @container ec-vendor (max-width: 280px) {
    #ec-vendors-{{ section.id }} .ec-vendors__identity { flex-wrap: wrap; gap: 8px; }
    #ec-vendors-{{ section.id }} .ec-vendors__details { order: 1; flex-basis: 100%; }
    #ec-vendors-{{ section.id }} .ec-vendors__avatar { width: 42px; height: 42px; flex: 0 1 42px; max-width: 100%; }
    #ec-vendors-{{ section.id }} .ec-vendors__badge { width: 34px; height: 34px; flex: 0 1 34px; max-width: 100%; }
    #ec-vendors-{{ section.id }} .ec-vendors__badge svg { width: 22px; height: 22px; }
    #ec-vendors-{{ section.id }} .ec-vendors__name,
    #ec-vendors-{{ section.id }} .ec-vendors__role { font-size: 16px; }
    #ec-vendors-{{ section.id }} .ec-vendors__products { gap: 8px; }
  }
  @media (max-width: 749px) {
    #ec-vendors-{{ section.id }} { padding: min({{ section.settings.section_padding }}px, 56px) 16px; }
    #ec-vendors-{{ section.id }} .ec-vendors__header { margin-bottom: 36px; }
    #ec-vendors-{{ section.id }} .ec-vendors__grid { grid-template-columns: repeat(var(--ec-columns-mobile), minmax(0, 1fr)); gap: 20px; }
    #ec-vendors-{{ section.id }} .ec-vendors__card { min-height: 230px; padding: min(var(--ec-card-padding), 24px); border-radius: 24px; }
    #ec-vendors-{{ section.id }} .ec-vendors__name,
    #ec-vendors-{{ section.id }} .ec-vendors__role { font-size: 20px; }
    #ec-vendors-{{ section.id }} .ec-vendors__products-label { margin-top: 28px; }
    {% if section.settings.columns_mobile == '2' %}
      #ec-vendors-{{ section.id }} .ec-vendors__card { padding: min(var(--ec-card-padding), 14px); }
      #ec-vendors-{{ section.id }} .ec-vendors__identity { flex-wrap: wrap; gap: 8px; }
      #ec-vendors-{{ section.id }} .ec-vendors__avatar { width: 42px; height: 42px; flex-basis: 42px; }
      #ec-vendors-{{ section.id }} .ec-vendors__details { order: 1; width: 100%; }
      #ec-vendors-{{ section.id }} .ec-vendors__name,
      #ec-vendors-{{ section.id }} .ec-vendors__role { font-size: 16px; }
      #ec-vendors-{{ section.id }} .ec-vendors__badge { width: 34px; height: 34px; flex-basis: 34px; }
      #ec-vendors-{{ section.id }} .ec-vendors__badge svg { width: 22px; height: 22px; }
      #ec-vendors-{{ section.id }} .ec-vendors__products { gap: 8px; }
    {% endif %}
  }
</style>

<section id="ec-vendors-{{ section.id }}" {% if section.settings.title != blank %}aria-labelledby="ec-vendors-title-{{ section.id }}"{% else %}aria-label="Vendedores"{% endif %}>
  <div class="ec-vendors__inner">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <header class="ec-vendors__header">
        {%- if section.settings.title != blank -%}
          <{{ heading_tag }} class="ec-vendors__title" id="ec-vendors-title-{{ section.id }}">{{ section.settings.title | escape }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="ec-vendors__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if vendor_definition.values_count > 0 -%}
      {%- paginate vendor_definition.values by 250 -%}
        <ul class="ec-vendors__grid" role="list">
          {%- for vendor in vendor_definition.values -%}
            {%- liquid
              assign vendor_name = vendor.name.value | default: 'Vendedor'
              assign vendor_photo = vendor.photo.value
              assign vendor_tier = vendor.tier.value | downcase | strip
              assign vendor_products = vendor.products.value
            -%}
            <li class="ec-vendors__card" data-vendor-card>
              <div class="ec-vendors__identity">
                <div class="ec-vendors__avatar">
                  {%- if vendor_photo != blank -%}
                    {{ vendor_photo | image_url: width: 120 | image_tag: widths: '60, 120', sizes: '60px', loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ avatar_icon }}
                  {%- endif -%}
                </div>
                <div class="ec-vendors__details">
                  <h3 class="ec-vendors__name">{{ vendor_name | escape }}</h3>
                  {%- if vendor.role.value != blank -%}<p class="ec-vendors__role">{{ vendor.role.value | escape }}</p>{%- endif -%}
                </div>
                {%- if vendor_tier == 'ouro' or vendor_tier == 'prata' or vendor_tier == 'bronze' -%}
                  <span class="ec-vendors__badge ec-vendors__badge--{{ vendor_tier }}" role="img" aria-label="Categoria {{ vendor_tier }}">
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m10 12 3-7h6l3 7M5 16h7l3 8-2 2H3l-1-2 3-8Zm15 0h7l3 8-1 2H19l-2-2 3-8Z"/></svg>
                  </span>
                {%- endif -%}
              </div>
              {%- if vendor_products != blank -%}
                <p class="ec-vendors__products-label">Produtos vendidos</p>
                <ul class="ec-vendors__products" role="list" aria-label="Produtos vendidos por {{ vendor_name | escape }}">
                  {%- for vendor_product in vendor_products -%}
                    {%- if vendor_product.url != blank -%}
                      <li>
                        <a class="ec-vendors__product" href="{{ vendor_product.url | escape }}" aria-label="{{ vendor_product.title | escape }}" title="{{ vendor_product.title | escape }}">
                          {%- if vendor_product.featured_image != blank -%}
                            {{ vendor_product.featured_image | image_url: width: 88 | image_tag: widths: '44, 88', sizes: '44px', loading: 'lazy', alt: '' }}
                          {%- else -%}
                            {{ shirt_icon }}
                          {%- endif -%}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}
          <nav class="ec-vendors__pagination" aria-label="Paginação de vendedores">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url | escape }}#ec-vendors-{{ section.id }}" rel="prev">Anterior</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url | escape }}#ec-vendors-{{ section.id }}" aria-label="Página {{ part.title | escape }}">{{ part.title | escape }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span aria-current="page">{{ part.title | escape }}</span>
              {%- else -%}
                <span>{{ part.title | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url | escape }}#ec-vendors-{{ section.id }}" rel="next">Próxima</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- elsif request.design_mode -%}
      <p class="ec-vendors__empty">Cadastre vendedores ativos no metaobjeto “{{ vendor_type | escape }}” e habilite o acesso à loja online para visualizar os cards.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vendedores · Metaobjeto",
  "tag": "div",
  "class": "ec-vendors-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Título da seção", "default": "Desafio Shopify" },
    { "type": "select", "id": "heading_tag", "label": "Nível do título", "options": [ { "value": "h1", "label": "H1 — título da página" }, { "value": "h2", "label": "H2 — título de seção" } ], "default": "h2" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo da seção", "default": "Seção para mostrar vendedores disponíveis de uma loja" },
    { "type": "header", "content": "Dados" },
    { "type": "text", "id": "metaobject_type", "label": "Tipo do metaobjeto", "default": "store_vendor", "info": "Use o identificador da definição, com acesso à loja online e entradas ativas." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Itens por linha no desktop", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "select", "id": "columns_mobile", "label": "Itens por linha no mobile", "options": [ { "value": "1", "label": "1 coluna" }, { "value": "2", "label": "2 colunas" } ], "default": "1" },
    { "type": "color", "id": "border_color", "label": "Cor da borda", "default": "#ffcf00" },
    { "type": "color", "id": "card_background", "label": "Cor de fundo do card", "default": "#fffcf7" },
    { "type": "color", "id": "section_background", "label": "Cor de fundo da seção", "default": "#f5f5f5" },
    { "type": "range", "id": "card_padding", "label": "Espaçamento interno do card", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "section_padding", "label": "Espaçamento vertical da seção", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 128 }
  ],
  "presets": [ { "name": "Vendedores · Metaobjeto" } ]
}
{% endschema %}
